# Dedicated subdomain, inside your existing HTTPS server block.
# Keep your working TLS certificate and other sites unchanged.
# server_name studio.example.com;
client_max_body_size 530m;
client_body_timeout 300s;

location / {
    proxy_pass http://127.0.0.1:8091;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
}

# Do not add a public alias for /media: files must pass application authentication.
