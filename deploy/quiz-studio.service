[Unit]
Description=Quiz of Thrones Content Studio
After=network.target

[Service]
Type=simple
User=quizstudio
Group=quizstudio
WorkingDirectory=/opt/quiz-studio
EnvironmentFile=/opt/quiz-studio/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/quiz-studio/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8091 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quiz-studio

[Install]
WantedBy=multi-user.target
