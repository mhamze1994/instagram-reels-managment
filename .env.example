PANEL_USER=quiz
PANEL_PASSWORD=choose-a-long-unique-password
PANEL_ORIGIN=http://SERVER-IP
PANEL_DATA=/var/lib/quiz-studio
PANEL_TEMPLATE=/opt/quiz-studio/template
QUIZ_FFMPEG=/usr/bin/ffmpeg
